# ==========================================
# RepoIntel Environment Configuration Template
# ==========================================

# ── Backend Configuration ─────────────────
# GitHub Personal Access Token (for fetching live repo metadata, commits, PRs)
# Generate from https://github.com/settings/tokens (public_repo scope sufficient)
GITHUB_TOKEN=

# Production Database URL (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/repointel
DATABASE_URL=sqlite:///./productivity.db

# MLflow Tracking URI (MLflow tracking registry server)
# e.g., http://localhost:5000 or sqlite:///mlflow.db
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# JWT Secret Key for token signing and authentication
JWT_SECRET=your-secure-random-jwt-secret-key

# Allowed CORS Origins (comma-separated domains)
# Development: http://localhost:3000,http://localhost:5173,http://localhost:8000
# Production: https://your-deployed-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ── Frontend Configuration ────────────────
# Backend API Base URL for React frontend
# Leave empty for relative proxy / same-domain deployments, or specify deployed backend URL
VITE_API_URL=
